{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Launch ShadowTrace OSINT (Local Dev Server)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "--experimental-sqlite", "src/local-dev.ts"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "APP_ENV": "development",
        "OFFLINE_MODE": "false"
      }
    },
    {
      "name": "📴 Launch ShadowTrace (Offline / Air-Gapped Mode)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "--experimental-sqlite", "src/local-dev.ts"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "APP_ENV": "development",
        "OFFLINE_MODE": "true"
      }
    },
    {
      "name": "⚡ Re-Index 16,800+ Catalogs (All 7 Repos)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "scripts/build-catalogs.ts"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "🩺 Run 15-Repository System Doctor",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "scripts/run-doctor.ts"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "🧪 Run All Tests (Worker & Reference Tools)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--experimental-strip-types",
        "--test",
        "tests/worker.test.mjs",
        "tests/reference_tools.test.mjs"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
